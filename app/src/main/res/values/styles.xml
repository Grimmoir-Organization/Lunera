<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Lunera" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#ffffff</item>
        <item name="android:enforceNavigationBarContrast" tools:ignore="NewApi">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch theme: a plain black system splash that LuneraIntro picks up from seamlessly. -->
    <style name="Theme.Lunera.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.Lunera</item>
    </style>

    <!-- Widget Theme with Material 3 colors fallback for API < 31 -->
    <style name="Theme.Widget.Lunera" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:colorBackground">#E6E1E5</item>
    </style>
</resources>
