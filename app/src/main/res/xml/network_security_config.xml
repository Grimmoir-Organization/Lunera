<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Device music and artwork never need a network connection. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors><certificates src="@raw/local_only_anchor" /></trust-anchors>
    </base-config>
    <!-- Only Lunera's release metadata, APK assets and release images use public TLS. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <trust-anchors><certificates src="system" /></trust-anchors>
    </domain-config>
</network-security-config>
